From: Batman <noreply@batman.invalid>
Subject: [PATCH] runc 1.1.14 -> 1.3.6 (container-escape CVEs); drop dockerd runc vendored check (#247-2)

winson3QQ/Batman#247 sub-item 2. CVE-2025-31133, CVE-2025-52565, CVE-2025-52881 (high) and CVE-2026-41579
(low) affect runc <= 1.2.7 / <= 1.3.5. Version + hash as openwrt-25.12; the 24.10 packaging is kept (25.12 adds
PKG_BUILD_DEPENDS += dockerd, which would close a cycle with containerd -> runc). moby 27.3.1 vendors runc
1.1.14, so dockerd's EnsureVendoredVersion check for runc is dropped until dockerd is upgraded (#250).

Batman-Witness: pkg runc 1.3.6-
--- a/feeds/packages/utils/runc/Makefile	2026-10-07 06:43:19.025399385 +0800
+++ b/feeds/packages/utils/runc/Makefile	2026-10-07 06:43:19.033399384 +0800
@@ -1,7 +1,9 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=runc
-PKG_VERSION:=1.1.14
+# Batman #247-2: 1.3.6 for CVE-2025-31133/52565/52881 (high, container escape) + CVE-2026-41579;
+# version+hash as openwrt-25.12, packaging kept from 24.10 (see dockerd: runc vendored check dropped)
+PKG_VERSION:=1.3.6
 PKG_RELEASE:=1
 PKG_LICENSE:=Apache-2.0
 PKG_LICENSE_FILES:=LICENSE
@@ -9,7 +11,7 @@
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://codeload.github.com/opencontainers/runc/tar.gz/v${PKG_VERSION}?
-PKG_HASH:=563cf57c38d2e7149234dbe6f63ca0751eb55ef8f586ed12a543dedc1aceba68
+PKG_HASH:=8816e8d4181d13012d16733e837425f5f67df57dfac28bc58a68f7dfcd54291b
 
 PKG_MAINTAINER:=Gerard Ryan <G.M0N3Y.2503@gmail.com>
 
--- a/feeds/packages/utils/dockerd/Makefile	2026-10-07 06:43:19.025399385 +0800
+++ b/feeds/packages/utils/dockerd/Makefile	2026-10-07 06:43:19.033399384 +0800
@@ -95,7 +95,8 @@
 
 	# Verify dependencies are the vendored version
 	$(call EnsureVendoredVersion,../containerd/Makefile,containerd.installer)
-	$(call EnsureVendoredVersion,../runc/Makefile,runc.installer)
+	# Batman #247-2: runc is 1.3.6 (container-escape CVEs) while moby 27.3.1 vendors runc 1.1.14 — the
+	# runc check is dropped on purpose until dockerd itself is upgraded (#250).
 	$(call EnsureVendoredVersion,../tini/Makefile,tini.installer)
 
 	# Verify CLI is the same version
