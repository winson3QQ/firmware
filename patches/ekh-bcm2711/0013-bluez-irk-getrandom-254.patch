From: Batman <noreply@batman.invalid>
Subject: [PATCH] bluez: IRK via getrandom(2); SecureConnections mode on every start (#254)

winson3QQ/Batman#254 stage 1 (PR-F). Adds bluez feed patch 900 (src/adapter.c):
1. F26: generate_and_write_irk() takes the 16 bytes from getrandom(2). BlueZ made the IRK
   through bt_crypto_new(), which needs AF_ALG ecb/cmac sockets; the Batman kernel ships no
   CRYPTO_USER_API (kmod-crypto-user stays out: it would expose the kernel crypto API to every
   local process), so no IRK was generated, privacy was never enabled and the node advertised
   with its public address (04, 1.5.12-wsl.3/.4).
2. v16 review N1: SET_SECURE_CONN with the configured mode (SecureConnections=only -> 0x02)
   is sent every time bluetoothd takes the adapter, not only while SC is off, and logged
   ("Batman: SecureConnections mode 2 requested"). The kernel exposes no "SC only" bit, so the
   outcome is written to /var/lib/bluetooth/batman-sc (root 0600, tmpfs): boot_id, pid, index,
   mode, mgmt status (v17 review R1: logd's ring drops log lines within the hour).
Design: Batman docs/design/254-stage1-impl.md F26, F27, §4.6.

Batman-Witness: file usr/bin/bluetoothd Batman: SecureConnections mode %u requested
--- /dev/null
+++ b/feeds/packages/utils/bluez/patches/900-batman-irk-getrandom.patch
@@ -0,0 +1,136 @@
+Batman #254: IRK via getrandom(2) (F26); SecureConnections mode sent every start (v16 N1)
+
+bt_crypto_new() opens AF_ALG ecb(aes)/cmac(aes) sockets; the Batman kernel ships no
+CRYPTO_USER_API, so the IRK was never generated and Privacy=device never took effect.
+SET_SECURE_CONN was sent only while SC was off, so SecureConnections=only could be lost
+for good once SC had been switched on, with nothing in current settings to show it.
+
+--- a/src/adapter.c
++++ b/src/adapter.c
+@@ -21,6 +21,7 @@
+ #include <stdlib.h>
+ #include <stdbool.h>
+ #include <sys/ioctl.h>
++#include <sys/random.h>
+ #include <sys/file.h>
+ #include <sys/stat.h>
+ #include <dirent.h>
+@@ -4161,32 +4162,27 @@
+ static int generate_and_write_irk(uint8_t *irk, GKeyFile *key_file,
+ 							const char *filename)
+ {
+-	struct bt_crypto *crypto;
+ 	char str_irk_out[33];
+ 	gsize length = 0;
+ 	GError *gerr = NULL;
+ 	char *str;
+ 	int i;
+ 
+-	crypto = bt_crypto_new();
+-	if (!crypto) {
+-		error("Failed to open crypto");
+-		return -1;
+-	}
+-
+-	if (!bt_crypto_random_bytes(crypto, irk, 16)) {
+-		error("Failed to generate IRK");
+-		bt_crypto_unref(crypto);
++	/* Batman #254: take the 16 random bytes from getrandom(2), not from
++	 * bt_crypto_new(), which needs AF_ALG (ecb/cmac sockets) that this kernel
++	 * does not ship. Without an IRK set_privacy() never enables privacy and the
++	 * controller advertises with its public address. Blocks until the kernel
++	 * CRNG is ready; any failure leaves privacy off, as upstream does. */
++	if (getrandom(irk, 16, 0) != 16) {
++		error("Failed to generate IRK (getrandom): %s", strerror(errno));
+ 		return -1;
+ 	}
+ 
+-	bt_crypto_unref(crypto);
+-
+ 	for (i = 0; i < 16; i++)
+ 		sprintf(str_irk_out + (i * 2), "%02x", irk[i]);
+ 
+ 	str_irk_out[32] = '\0';
+-	info("Generated IRK successfully");
++	info("Generated IRK (getrandom)");
+ 
+ 	g_key_file_set_string(key_file, "General", "IdentityResolvingKey",
+ 								str_irk_out);
+@@ -10192,6 +10188,51 @@
+ 	btd_error(adapter->dev_id, "Failed to read exp features info");
+ }
+ 
++/* Batman #254 (v17 review R1): the SecureConnections outcome as a file, not a
++ * log line (logd's 128 KiB ring drops it within the hour and any local process
++ * can flood it). One line, rewritten atomically by bluetoothd only, in the
++ * root-only 0700 store on tmpfs (umask 0077 -> 0600):
++ *   boot_id=<kernel boot_id> pid=<bluetoothd pid> index=<hci> mode=<0|1|2> status=<mgmt status>
++ * status 0 = applied; 0xff = could not be sent. A reader accepts it only for
++ * this boot and the running bluetoothd pid. */
++static void batman_sc_record(struct btd_adapter *adapter, uint8_t status)
++{
++	char filename[PATH_MAX];
++	char boot_id[64] = "";
++	char *str;
++	FILE *f;
++
++	f = fopen("/proc/sys/kernel/random/boot_id", "r");
++	if (f) {
++		if (!fgets(boot_id, sizeof(boot_id), f))
++			boot_id[0] = '\0';
++		fclose(f);
++	}
++	boot_id[strcspn(boot_id, "\n")] = '\0';
++
++	create_filename(filename, PATH_MAX, "/batman-sc");
++	str = g_strdup_printf("boot_id=%s pid=%d index=%u mode=%u status=%u\n",
++				boot_id, (int) getpid(), adapter->dev_id,
++				btd_opts.secure_conn, status);
++	if (!g_file_set_contents(filename, str, -1, NULL))
++		error("Batman: cannot write %s", filename);
++	g_free(str);
++}
++
++static void batman_sc_complete(uint8_t status, uint16_t length,
++					const void *param, void *user_data)
++{
++	struct btd_adapter *adapter = user_data;
++
++	batman_sc_record(adapter, status);
++	if (status != MGMT_STATUS_SUCCESS) {
++		btd_error(adapter->dev_id, "Batman: SecureConnections mode %u failed: %s (0x%02x)",
++				btd_opts.secure_conn, mgmt_errstr(status), status);
++		return;
++	}
++	new_settings_callback(adapter->dev_id, length, param, adapter);
++}
++
+ static void read_info_complete(uint8_t status, uint16_t length,
+ 					const void *param, void *user_data)
+ {
+@@ -10303,9 +10344,22 @@
+ 		break;
+ 	}
+ 
+-	if (missing_settings & MGMT_SETTING_SECURE_CONN)
+-		set_mode(adapter, MGMT_OP_SET_SECURE_CONN,
+-					btd_opts.secure_conn);
++	/* Batman #254 (v16 N1, v17 R1): upstream sends SET_SECURE_CONN only while
++	 * SC is off, so once anything turned SC on (root: bluetoothctl mgmt.sc on)
++	 * SecureConnections=only was never applied again, and current settings has
++	 * no bit that shows "only". Send the configured mode every time the daemon
++	 * takes the adapter (LE-only: the kernel changes the flags even while
++	 * powered) and record the outcome in the root-only store, see
++	 * batman_sc_complete(). */
++	if (adapter->supported_settings & MGMT_SETTING_SECURE_CONN) {
++		struct mgmt_mode sc_cp = { .val = btd_opts.secure_conn };
++
++		info("Batman: SecureConnections mode %u requested", btd_opts.secure_conn);
++		if (!mgmt_send(adapter->mgmt, MGMT_OP_SET_SECURE_CONN,
++				adapter->dev_id, sizeof(sc_cp), &sc_cp,
++				batman_sc_complete, adapter, NULL))
++			batman_sc_record(adapter, 0xff);
++	}
+ 
+ 	if (adapter->supported_settings & MGMT_SETTING_PRIVACY)
+ 		set_privacy(adapter, btd_opts.privacy);
